# Public hostnames (DNS A records -> this server). Caddy gets TLS certificates for each.
APP_HOST=maple.example.com
API_HOST=api.maple.example.com
SYNC_HOST=sync.maple.example.com
AUTH_HOST=auth.maple.example.com
INGEST_HOST=ingest.maple.example.com
ACME_EMAIL=it@example.com

# Outgoing email (alerts, invitations). smtps://user:pass@host:465 or smtp://user:pass@host:587
SMTP_URL=
SMTP_INSECURE=0
EMAIL_FROM=maple@example.com

# Filled by scripts/gen-secrets.sh. Never change the two MAPLE_INGEST_KEY_* after first start.
POSTGRES_PASSWORD=
CLICKHOUSE_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
MAPLE_ROOT_PASSWORD=
MAPLE_INGEST_KEY_ENCRYPTION_KEY=
MAPLE_INGEST_KEY_LOOKUP_HMAC_KEY=
MAPLE_SHARE_TOKEN_HMAC_KEY=
INTERNAL_SERVICE_TOKEN=
SANDBOX_INTERNAL_SERVICE_TOKEN=
