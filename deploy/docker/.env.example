# Public hostnames (DNS A records -> this server). Caddy gets TLS certificates for each.
APP_HOST=maple.example.com
API_HOST=api.maple.example.com
SYNC_HOST=sync.maple.example.com
AUTH_HOST=auth.maple.example.com
INGEST_HOST=ingest.maple.example.com
STATUS_HOST=status.maple.example.com
ACME_EMAIL=it@example.com

# Outgoing email (alerts, invitations). smtps://user:pass@host:465 or smtp://user:pass@host:587
SMTP_URL=
SMTP_INSECURE=0
EMAIL_FROM=maple@example.com

# The company or organization name shown on the sign-in pages and in Keycloak emails (applied by scripts/bootstrap.sh).
REALM_DISPLAY_NAME=Maple

# Optional: an org's PUBLIC ingest key (maple_pk_..., Settings -> Ingestion) so Maple's own dashboard
# reports its performance into that org. Baked into the web build: rebuild `caddy` after changing it.
MAPLE_WEB_INGEST_KEY=

# Filled by scripts/gen-secrets.sh. Never change the two MAPLE_INGEST_KEY_* after first start.
POSTGRES_PASSWORD=
CLICKHOUSE_ADMIN_PASSWORD=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
MAPLE_ROOT_PASSWORD=
MAPLE_INGEST_KEY_ENCRYPTION_KEY=
MAPLE_INGEST_KEY_LOOKUP_HMAC_KEY=
MAPLE_SHARE_TOKEN_HMAC_KEY=
INTERNAL_SERVICE_TOKEN=
SANDBOX_INTERNAL_SERVICE_TOKEN=
ELECTRIC_SECRET=
SD_INTERNAL_TOKEN=
MAPLE_SESSION_SIGNING_SECRET=
MAPLE_OIDC_ADMIN_CLIENT_SECRET=

# Sign-in session lifetimes (seconds): idle TTL and absolute maximum.
MAPLE_OIDC_SESSION_TTL_SECONDS=600
MAPLE_OIDC_SESSION_MAX_LIFETIME_SECONDS=43200

# bootstrap.sh: 1 = remove Keycloak's account console from users' default roles.
KEYCLOAK_CLOSE_ACCOUNT_CONSOLE=1

# Per-org data retention. Org admins set days in Settings > Data platform; this caps them.
# Leave empty for no ceiling beyond each table's shipped TTL (30/90 days).
MAPLE_RETENTION_MAX_DAYS=
# Optional ceiling (bytes) on any org's size cap, e.g. 53687091200 for 50 GB. Empty = none.
# An org with no cap of its own is held to it. Approximate: checked on each sweep.
MAPLE_RETENTION_MAX_BYTES=
# Free-disk guard: when free space on ClickHouse's disk falls below this percent (e.g. 10), each
# sweep drops the oldest daily partitions of ALL orgs until it is back above (plus 2 points). Empty = off.
MAPLE_CLICKHOUSE_MIN_FREE_PERCENT=
# Minutes between retention sweeps (run by the scraper).
MAPLE_RETENTION_SWEEP_MINUTES=60
